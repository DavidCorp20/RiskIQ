APP_ENV=development
MONGO_URL=mongodb://localhost:27017
MONGO_DB=riskiq_dev
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=20
GEMINI_API_KEY=
FRESHSERVICE_ENABLED=false
FRESHSERVICE_BASE_URL=https://yourdomain.freshservice.com
FRESHSERVICE_API_KEY=
FRESHSERVICE_WEBHOOK_SECRET=
FRESHSERVICE_CRITICAL_POLICY_STATUSES=APPROVED,DEPLOYED,RETIRED
FRESHSERVICE_TIMEOUT_SECONDS=8
FRESHSERVICE_MAX_RETRIES=3
FRESHSERVICE_RETRY_BACKOFF_SECONDS=0.5
FRESHSERVICE_MAX_RETRY_DELAY_SECONDS=30
FRESHSERVICE_MAX_CONNECTIONS=10
FRESHSERVICE_MAX_KEEPALIVE_CONNECTIONS=5

# Market Intelligence (analytical Copilot only)
MARKET_CONTEXT_ENABLED=true
MARKET_CONTEXT_CACHE_TTL_SECONDS=60
MARKET_CONTEXT_TIMEOUT_SECONDS=3
MARKET_NQ_SYMBOL=NQ=F
MARKET_NQ_URL=https://query1.finance.yahoo.com/v8/finance/chart/NQ=F?range=1d&interval=5m
